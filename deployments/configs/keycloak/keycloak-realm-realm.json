{
  "realm": "keycloak-realm",
  "enabled": true,
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "sslRequired": "external",
  "roles": {
    "realm": [
      {
        "name": "USER",
        "description": "Customer: can register passengers and book flights"
      },
      {
        "name": "ADMIN",
        "description": "Administrator: can manage flights, seats, airports and aircraft"
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}"
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}"
      }
    ]
  },
  "clients": [
    {
      "clientId": "travel-web",
      "name": "Travel website",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "booking-client-credentials",
      "name": "Service client for scripts and booking.rest",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "secret",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "service-account-booking-client-credentials",
      "enabled": true,
      "serviceAccountClientId": "booking-client-credentials",
      "realmRoles": [
        "ADMIN"
      ]
    },
    {
      "username": "admin",
      "email": "admin@example.com",
      "firstName": "Demo",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN",
        "USER"
      ]
    },
    {
      "username": "traveller",
      "email": "traveller@example.com",
      "firstName": "Demo",
      "lastName": "Traveller",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "traveller123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "USER"
      ]
    }
  ],
  "defaultRoles": [
    "USER"
  ]
}
