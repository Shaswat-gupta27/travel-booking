
@api-gateway=http://localhost:8081
@keycloak-api=http://localhost:8080
@flight-api=http://localhost:8082
@passenger-api=http://localhost:8083
@booking-api=http://localhost:8084

@contentType = application/json
@flightId = "3c5c0000-97c6-fc34-2eb9-08db322230c9"
@passengerId = "4c5c0000-97c6-fc34-a0cb-08db322230c0"
@aircraftId = "3c5c0000-97c6-fc34-fcd3-08db322230c8"
@arriveAirportId = "3c5c0000-97c6-fc34-a0cb-08db322230c8"
@departureAirportId = "3c5c0000-97c6-fc34-fc3c-08db322230c8"
################################# Keycloak API #################################

###
# @name ApiRoot_Keycloak
GET {{keycloak-api}}
###


###
# @name Authenticate
POST {{keycloak-api}}/realms/keycloak-realm/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials
&client_id=booking-client-credentials
&client_secret=secret
&scope=openid
###


################################# Flight API #################################

###
# @name ApiRoot_Flight
GET {{flight-api}}
###

###
# @name Create_Seat
Post {{api-gateway}}/api/v1/flight/seat
accept: application/json
Content-Type: application/json
authorization: bearer {{Authenticate.response.body.access_token}}

{
  "seatNumber": "1255",
  "seatType": "Window",
  "seatClass": "FirstClass",
  "flightId": {{flightId}}
}
###


###
# @name Reserve_Seat
Post {{api-gateway}}/api/v1/flight/reserve-seat
accept: application/json
Content-Type: application/json
authorization: bearer {{Authenticate.response.body.access_token}}

{
  "seatNumber":"1255",
  "flightId": {{flightId}}
}
###


###
# @name Get_Available_Seats
GET {{api-gateway}}/api/v1/flight/get-available-seats/3c5c0000-97c6-fc34-2eb9-08db322230c9
accept: application/json
Content-Type: application/json
authorization: bearer {{Authenticate.response.body.access_token}}
###


###
# @name Get_Flight_By_Id
GET {{api-gateway}}/api/v1/flight/3c5c0000-97c6-fc34-2eb9-08db322230c9
accept: application/json
Content-Type: application/json
authorization: bearer {{Authenticate.response.body.access_token}}
###


###
# @name Get_Available_Flights
GET {{api-gateway}}/api/v1/flight
accept: application/json
Content-Type: application/json
authorization: bearer {{Authenticate.response.body.access_token}}
###


###
# @name Create_Flights
POST {{api-gateway}}/api/v1/flight
accept: application/json
Content-Type: application/json
authorization: bearer {{Authenticate.response.body.access_token}}

{
  "flightNumber": "20BB",
  "aircraftId": {{aircraftId}},
  "departureAirportId": {{departureAirportId}},
  "departureDate": "2022-03-01T14:55:41.255Z",
  "arriveDate": "2022-03-01T14:55:41.255Z",
  "arriveAirportId": {{arriveAirportId}},
  "durationMinutes": 120,
  "flightDate": "2022-03-01T14:55:41.255Z",
  "status": "Delay",
  "price": 8000,
  "numberOfSeats": 180,
  "seatsPerRow": 6
}
###


###
# @name Update_Flights
PUT  {{api-gateway}}/api/v1/flight/01949849-1608-7e16-975a-e7f4cf1d029d
accept: application/json
Content-Type: application/json
authorization: bearer {{Authenticate.response.body.access_token}}

{
  "flightNumber": "20BB",
  "aircraftId": {{aircraftId}},
  "departureAirportId": {{departureAirportId}},
  "departureDate": "2025-01-24T12:35:11.803Z",
  "arriveDate": "2025-01-24T12:35:11.803Z",
  "arriveAirportId": {{arriveAirportId}},
  "durationMinutes": 140,
  "flightDate": "2025-01-24T12:35:11.803Z",
  "status": "Flying",
  "price": 8000,
  "isDeleted": false
}
###


###
# @name Delete_Flights
DELETE   {{api-gateway}}/api/v1/flight/01949849-1608-7e16-975a-e7f4cf1d029d
accept: application/json
Content-Type: application/json
authorization: bearer {{Authenticate.response.body.access_token}}
###


###
# @name Create_Airport
POST {{api-gateway}}/api/v1/flight/airport
accept: application/json
Content-Type: application/json
authorization: bearer {{Authenticate.response.body.access_token}}

{
  "name": "mehrabad",
  "address": "tehran",
  "code": "12YD",
  "city": "Tehran",
  "region": "Tehran",
  "country": "Iran"
}
###

###
# @name Search_Flights
# from/to match airport name, code, city, region or country (partial text, ignoring case).
# optional: date=yyyy-MM-dd (departure day), sort=departure|price|duration, page (from 1), size (max 100)
GET {{api-gateway}}/api/v1/flight/search?from=Delhi&to=California&sort=price&page=1&size=20
accept: application/json
###

###
# @name Get_Airports
# optional filters: ?q=california (name, code, city, region or country) and ?city=Los Angeles
GET {{api-gateway}}/api/v1/flight/airport
accept: application/json
###

###
# @name Get_Airport_By_Id
GET {{api-gateway}}/api/v1/flight/airport/3c5c0000-97c6-fc34-a0cb-08db322230c8
accept: application/json
###

###
# @name Get_Aircrafts
GET {{api-gateway}}/api/v1/flight/aircraft
accept: application/json
###

###
# @name Get_Aircraft_By_Id
GET {{api-gateway}}/api/v1/flight/aircraft/3c5c0000-97c6-fc34-fcd3-08db322230c8
accept: application/json
###



###
# @name Create_Aircraft
POST {{api-gateway}}/api/v1/flight/aircraft
accept: application/json
Content-Type: application/json
authorization: bearer {{Authenticate.response.body.access_token}}

{
  "name": "airbus2",
  "model": "322",
  "manufacturingYear": 2012
}
###


################################# Passenger API #################################

###
# @name ApiRoot_Passenger
GET {{passenger-api}}
###


###
# @name Register_Passenger
POST {{api-gateway}}/api/v1/passenger
accept: application/json
Content-Type: application/json
authorization: bearer {{Authenticate.response.body.access_token}}

{
  "name": "test-passenger",
  "passportNumber": "412900000000",
  "passengerType": 1,
  "age": 30
}
###


###
# @name Get_My_Passengers
# the caller's saved travellers
GET  {{api-gateway}}/api/v1/passenger
accept: application/json
authorization: bearer {{Authenticate.response.body.access_token}}
###

###
# @name Get_Passenger_By_Id
# owner or admin only, otherwise 404 (the seeded passenger below has no owner, so only an admin can read it)
GET  {{api-gateway}}/api/v1/passenger/4c5c0000-97c6-fc34-a0cb-08db322230c0
accept: application/json
Content-Type: application/json
authorization: bearer {{Authenticate.response.body.access_token}}
###

###
# @name Update_Passenger
# owner or admin; the passport number stays unique per owner
PUT  {{api-gateway}}/api/v1/passenger/{{Register_Passenger.response.body.id}}
accept: application/json
Content-Type: application/json
authorization: bearer {{Authenticate.response.body.access_token}}

{
  "name": "test-passenger",
  "passportNumber": "412900000000",
  "passengerType": "Female",
  "age": 31
}
###


################################# Booking API #################################

###
# @name ApiRoot_Booking
GET {{booking-api}}
###


###
# @name Create_Booking
POST {{api-gateway}}/api/v1/booking
accept: application/json
Content-Type: application/json
authorization: bearer {{Authenticate.response.body.access_token}}

{
  "passengerId": {{passengerId}},
  "flightId": {{flightId}},
  "description": "I want to fly to iran"
}
###

###
# @name Get_My_Bookings
# only the caller's bookings (needs a USER or ADMIN token; the service-account token has its own id)
GET {{api-gateway}}/api/v1/booking
accept: application/json
authorization: bearer {{Authenticate.response.body.access_token}}
###

###
# @name Get_Booking_By_Id
# owner or admin only, otherwise 404
GET {{api-gateway}}/api/v1/booking/{{Create_Booking.response.body.id}}
accept: application/json
authorization: bearer {{Authenticate.response.body.access_token}}
###

###
# @name Cancel_Booking
# owner or admin; marks the booking Cancelled and frees the seat
DELETE {{api-gateway}}/api/v1/booking/{{Create_Booking.response.body.id}}
accept: application/json
authorization: bearer {{Authenticate.response.body.access_token}}
###
